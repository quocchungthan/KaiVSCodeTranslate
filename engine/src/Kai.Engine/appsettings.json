{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Warning"
    }
  },
  "Engine": {
    "ListenAddress": "127.0.0.1",
    "Port": 7443,
    "RepositoryRoot": "",
    "DatabasePath": "_processing/engine/engine.db",
    "MaxUploadBytes": 1073741824,
    "DefaultAgent": "Huong",
    "ImportExistingCompletedJobs": true,
    "Scheduler": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "LeaseSeconds": 300,
      "LeaseRenewSeconds": 60,
      "MaxAttempts": 3,
      "RetryBackoffSeconds": 300,
      "MaxConcurrentRuns": 1
    },
    "Agents": [
      { "Name": "Huong", "Enabled": true, "MaxConcurrentJobs": 1 }
    ],
    "Copilot": {
      "PowerShellExecutable": "pwsh",
      "UseAutopilot": true,
      "TurnTimeoutMinutes": 240,
      "AutopilotQuietMinutes": 10,
      "TerminalGraceSeconds": 120,
      "WatchdogPollSeconds": 30,
      "MaxContinuations": 25,
      "MaxStalledTurns": 3,
      "RunTimeoutHours": 48,
      "AgentsDirectory": ".github/agents",
      "SkillsDirectory": ".github/skills"
    }
  }
}
